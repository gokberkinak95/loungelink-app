        {
          "fonts": [
            "./assets/fonts/CormorantGaramond-Light.ttf",
            "./assets/fonts/CormorantGaramond-Bold.ttf",
            "./assets/fonts/CormorantGaramond-SemiBold.ttf",
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
